---
import { DownloadDropdown } from "./DownloadDropdown";
import { HeroReleaseBadge } from "./HeroReleaseBadge";
import { Cpu, ShieldCheck, Zap, Puzzle } from "lucide-react";
import type { GitHubRelease } from "@/lib/github";

interface Props {
  release?: GitHubRelease | null;
}

const { release = null } = Astro.props;
---

<section class="relative overflow-hidden bg-[#0a0a0a] pt-32 pb-16 md:pt-36 md:pb-24">
  <div class="mx-auto max-w-7xl px-4 text-center sm:px-6 lg:px-8">
    <!-- Release Badge -->
    <HeroReleaseBadge client:load initialRelease={release} />

    <!-- Main Hero Heading -->
    <h1
      class="mx-auto max-w-4xl text-4xl leading-[1.1] font-extrabold tracking-tight text-white sm:text-6xl lg:text-7xl"
    >
      Быстрый, легкий и модульный лаунчер на <span class="text-gradient">Rust</span>
    </h1>

    <!-- Subtitle -->
    <p
      class="mx-auto mt-6 max-w-2xl text-base leading-relaxed font-normal text-slate-300 sm:text-lg lg:text-xl"
    >
      Многопоточный асинхронный загрузчик ассетов, изолированные инстансы, расширяемая модульная
      система аддонов и автоматическая оптимизация Aikar's GC.
    </p>

    <!-- Download Dropdown Component -->
    <div class="mt-9 flex flex-col items-center justify-center gap-4">
      <DownloadDropdown client:load initialRelease={release} />

      <div
        class="mt-2 flex flex-wrap items-center justify-center gap-6 font-mono text-xs text-slate-400"
      >
        <span class="flex items-center gap-1.5">
          <Zap className="h-3.5 w-3.5 text-emerald-400" /> ~40 МБ потребление ОЗУ
        </span>
        <span class="flex items-center gap-1.5">
          <Puzzle className="h-3.5 w-3.5 text-purple-400" /> Модульный Addon API
        </span>
        <span class="flex items-center gap-1.5">
          <Cpu className="h-3.5 w-3.5 text-slate-300" /> Авто-Java 8 / 17 / 21
        </span>
        <span class="flex items-center gap-1.5">
          <ShieldCheck className="h-3.5 w-3.5 text-slate-300" /> Лицензия MIT
        </span>
      </div>
    </div>
  </div>
</section>
