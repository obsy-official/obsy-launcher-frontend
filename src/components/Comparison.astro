---
import { Zap } from "lucide-react";

const features = [
  {
    category: "Производительность",
    name: "Технологический стек",
    obsy: "Нативный Rust (0% оверхеда)",
    legacy: "Java Swing / Electron",
    official: "Chromium / CEF",
  },
  {
    category: "Производительность",
    name: "Время холодного запуска",
    obsy: "~0.4 сек",
    legacy: "4.5 — 8.0 сек",
    official: "3.0 — 5.5 сек",
  },
  {
    category: "Производительность",
    name: "Потребление памяти (RAM)",
    obsy: "35 — 50 МБ",
    legacy: "180 — 350 МБ",
    official: "120 — 220 МБ",
  },
  {
    category: "Сеть и файлы",
    name: "Движок загрузки ассетов",
    obsy: "Асинхронный HTTP/2 (до 50 потоков)",
    legacy: "Последовательный (1–4 потока)",
    official: "Ограниченный (до 4 потоков)",
  },
  {
    category: "Архитектура",
    name: "Изоляция инстансов",
    obsy: "Отдельные каталоги по умолчанию",
    legacy: "Общая папка .minecraft",
    official: "Общая папка .minecraft",
  },
  {
    category: "Модульность",
    name: "Система аддонов и UI-слоты",
    obsy: "Встроенный Addon API (React + хуки)",
    legacy: "Отсутствует / Закрытые плагины",
    official: "Отсутствует",
  },
  {
    category: "Кастомизация",
    name: "Темы и виджеты",
    obsy: "Кастомные темы, 3D скины, Discord RPC",
    legacy: "Только базовые темные темы",
    official: "Фиксированный интерфейс",
  },
  {
    category: "Java & JVM",
    name: "Управление средой Java",
    obsy: "Авто-загрузка Eclipse Temurin под версию",
    legacy: "Требует ручной установки",
    official: "Встроенный JRE",
  },
  {
    category: "Java & JVM",
    name: "Флаги сборщика мусора (GC)",
    obsy: "Aikar's G1GC флаги из коробки",
    legacy: "Стандартные параметры JVM",
    official: "Стандартные параметры JVM",
  },
  {
    category: "Экосистема",
    name: "Модель распространения",
    obsy: "Открытый код (MIT) • 0% рекламы",
    legacy: "Закрытый код / Баннеры",
    official: "Проприетарный",
  },
];
---

<section id="comparison" class="relative py-20 md:py-28">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mx-auto mb-16 max-w-3xl text-center">
      <div
        class="mb-4 inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-3 py-1 font-mono text-xs text-slate-300"
      >
        <span>Архитектура и характеристики</span>
      </div>
      <h2 class="text-3xl font-extrabold tracking-tight text-white sm:text-5xl">
        Сравнение с <span class="text-gradient">другими решениями</span>
      </h2>
      <p class="mt-4 text-base text-slate-300 sm:text-lg">
        Технические различия в потреблении системных ресурсов, архитектуре загрузки, модульности и
        управлении сборками.
      </p>
    </div>

    {/* Clean Technical Table */}
    <div
      class="overflow-hidden rounded-2xl border border-white/10 bg-white/[0.02] shadow-xl backdrop-blur-md"
    >
      <div class="overflow-x-auto">
        <table class="w-full min-w-[680px] border-collapse text-left">
          <thead>
            <tr class="border-b border-white/10 bg-white/[0.03] font-mono text-xs text-slate-400">
              <th class="px-6 py-4 font-semibold">Параметр</th>
              <th
                class="border-x border-white/10 bg-white/5 px-6 py-4 text-sm font-bold text-white"
              >
                <div class="flex items-center gap-2">
                  <Zap className="h-4 w-4 text-emerald-400" />
                  <span>Obsy Launcher (Rust)</span>
                </div>
              </th>
              <th class="px-6 py-4 font-semibold">Java Swing / Electron лаунчеры</th>
              <th class="px-6 py-4 font-semibold">Официальный лаунчер</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-white/5 text-sm">
            {
              features.map((item, idx) => (
                <tr
                  class={`transition-colors hover:bg-white/[0.04] ${idx % 2 === 0 ? "bg-transparent" : "bg-white/[0.01]"}`}
                >
                  <td class="px-6 py-4 font-medium text-slate-200">
                    <div>{item.name}</div>
                    <div class="font-mono text-[11px] text-slate-400">{item.category}</div>
                  </td>
                  <td class="border-x border-white/10 bg-white/5 px-6 py-4 font-mono text-xs font-semibold text-emerald-300 sm:text-sm">
                    {item.obsy}
                  </td>
                  <td class="px-6 py-4 font-mono text-xs text-slate-400 sm:text-sm">
                    {item.legacy}
                  </td>
                  <td class="px-6 py-4 font-mono text-xs text-slate-400 sm:text-sm">
                    {item.official}
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
  </div>
</section>
