---
import { MessageSquare } from "lucide-react";
import { GITHUB_REPO_URL } from "@/lib/github";
import { FooterReleaseLabel } from "./FooterReleaseLabel";
import type { GitHubRelease } from "@/lib/github";

interface Props {
  release?: GitHubRelease | null;
}

const { release = null } = Astro.props;
---

<footer
  class="relative overflow-hidden border-t border-white/10 bg-[#060608]/90 pt-16 pb-12 backdrop-blur-md"
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 gap-10 border-b border-white/10 pb-12 md:grid-cols-5">
      {/* Brand Col */}
      <div class="space-y-4 md:col-span-2">
        <div class="flex items-center gap-3">
          <svg
            viewBox="0 0 29 39"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
            class="h-7 w-auto text-white"
          >
            <title>Logo</title>
            <path
              fill="currentColor"
              d="M14.656 38.343c-.39-.098-1.054-.457-3.35-1.8-.555-.326-1.171-.685-1.367-.799a10.675 10.675 0 0 1-.43-.26c-.038-.033-.483-.277-.975-.554-1.164-.636-2.132-1.197-2.609-1.515-.382-.253-.39-.269-1.803-3.266-1.632-3.445-2.124-4.537-3.46-7.616C.32 21.743.1 21.035.1 20.725c0-.179.117-.619.281-1.026.156-.39.687-1.751 1.18-3.03a235.91 235.91 0 0 1 1.272-3.258 326.815 326.815 0 0 0 1.523-3.844c.125-.334.312-.644.46-.774.29-.26 2.047-1.474 7.232-5C17.795-.102 17.717-.06 18.029.02c.211.057.688.505 1.062 1.01.281.375 1.226 1.63 1.656 2.2.39.52 3.858 5.163 5.232 7.004.515.692 1.32 1.775 1.788 2.402.469.628.922 1.304 1.008 1.5.148.333.156.415.07 1.058-.055.383-.14.92-.203 1.19-.094.414-.36 1.775-.586 3.013-.031.179-.172.912-.312 1.629-.14.716-.266 1.392-.29 1.506-.023.114-.187 1.01-.374 1.996-.187.985-.398 2.126-.468 2.525-.063.407-.172.994-.235 1.303-.062.318-.164.904-.234 1.303-.195 1.181-.352 1.645-.656 1.996-.258.293-1.6 1.23-4.966 3.461-.727.48-1.578 1.05-1.89 1.27-1.453 1.003-2.733 1.825-2.983 1.915-.313.114-.625.13-.992.04Zm.43-3.95c.257-.693.476-1.288.476-1.328a1.1 1.1 0 0 1 .164-.261c.156-.195.156-.195.89-.106.804.106 2.99.13 2.897.04-.031-.032-.258-.121-.5-.195-.242-.073-.812-.252-1.265-.39a69.548 69.548 0 0 0-1.366-.432c-.719-.228-.789-.277-.969-.717-.273-.652-1.007-2.256-2.592-5.612-.992-2.093-1.538-3.34-1.515-3.437.023-.081.773-.839 1.663-1.686s2.288-2.174 3.108-2.956c.82-.782 1.921-1.833 2.444-2.346.922-.888.969-.92 1.25-.88.156.017.562.171.906.342.343.163.85.416 1.124.546l.492.236-.039.709a41 41 0 0 1-.21 2.052c-.095.741-.196 1.621-.235 1.955-.031.334-.172 1.564-.305 2.729-.656 5.636-.913 8.438-.71 7.737.07-.22.367-1.8.546-2.85l.242-1.344c.086-.514.196-1.116.227-1.344.039-.22.18-1.027.312-1.792.281-1.58.688-3.958.781-4.561.04-.22.14-.864.227-1.426.242-1.523.257-1.572.515-1.71.133-.065.78-.31 1.445-.546l1.21-.423-1.757.016-1.757.008-.664-.326a26.368 26.368 0 0 0-1.6-.725c-.516-.211-.992-.44-1.055-.496-.062-.057-.164-.26-.21-.456-.47-1.703-.594-2.2-.805-3.12a49.138 49.138 0 0 0-.312-1.303c-.031-.13-.14-.668-.227-1.181-.093-.513-.203-1.116-.25-1.344-.046-.22-.14-.92-.218-1.547-.11-.913-.156-1.14-.25-1.14-.125 0-1.585 1.726-3.655 4.316-.578.717-1.171 1.45-1.327 1.629-.336.4-.68.823-1.164 1.442l-.367.472-.093 1.442c-.055.798-.133 2.508-.172 3.795-.047 1.295-.102 2.378-.117 2.411-.024.033-.047.79-.055 1.686l-.016 1.62.242.58c.133.317.828 1.824 1.546 3.338 2.554 5.433 2.874 6.134 2.952 6.524.031.139-.015.693-.109 1.255-.086.554-.195 1.23-.234 1.498-.04.27-.094.57-.125.676-.024.098-.016.18.031.18.039 0 .289-.562.554-1.255Zm-6.552-3.568a62.81 62.81 0 0 1-.156-1.939c-.04-.513-.125-1.629-.188-2.484-.18-2.33-.172-2.565.156-3.64.188-.636.266-1.019.242-1.222-.023-.171.016-.864.078-1.548.157-1.678.25-3.445.305-5.897.039-1.694.031-2.085-.062-2.272l-.118-.22-.656.839c-.359.456-.812 1.026-1.007 1.254a136.96 136.96 0 0 0-1.53 1.882c-.649.798-1.804 2.223-2.562 3.152-.765.936-1.366 1.743-1.35 1.792.015.057.304.138.647.187.336.049 1.039.155 1.554.228 1.039.155 1.523.269 1.523.367 0 .032.164.277.36.545.202.26.562.79.811 1.173.414.644.453.75.578 1.507.07.448.164 1.002.203 1.222l.242 1.384c.414 2.476.93 4.969.984 4.79.024-.058-.007-.554-.054-1.1ZM7.245 10.227a38.589 38.589 0 0 1 1.406-.212c.172-.025.43-.139.578-.253.46-.358 1.983-2.06 3.553-3.966.89-1.083.913-1.116.882-1.149-.039-.048-1.718 1.06-4.74 3.136-1.046.717-2.624 1.873-3.108 2.28-.297.245-.328.294-.195.343a.647.647 0 0 0 .336.024c.11-.016.687-.106 1.288-.203Z"
            ></path>
          </svg>
          <span class="text-lg font-bold text-white"> Obsy Launcher </span>
        </div>
        <p class="max-w-sm text-xs leading-relaxed text-slate-400">
          Легкий десктопный лаунчер на Rust с изолированными инстансами и параллельной загрузкой
          ассетов.
        </p>
        <div class="flex items-center gap-3 pt-2">
          <a
            href={GITHUB_REPO_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="rounded-xl border border-white/10 bg-white/5 p-2 text-slate-400 transition-colors hover:border-white/20 hover:text-white"
            aria-label="GitHub Repository"
          >
            <svg class="h-4 w-4 fill-current" viewBox="0 0 24 24">
              <path
                d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"
              ></path>
            </svg>
          </a>
          <a
            href="https://discord.com"
            target="_blank"
            rel="noopener noreferrer"
            class="rounded-xl border border-white/10 bg-white/5 p-2 text-slate-400 transition-colors hover:border-white/20 hover:text-white"
            aria-label="Discord Community"
          >
            <MessageSquare className="h-4 w-4" />
          </a>
        </div>
      </div>

      {/* Navigation links */}
      <div>
        <div class="mb-4 font-mono text-xs font-semibold text-slate-300">Навигация</div>
        <ul class="space-y-2.5 text-xs text-slate-400">
          <li><a href="#features" class="transition-colors hover:text-white">Архитектура</a></li>
          <li><a href="#comparison" class="transition-colors hover:text-white">Сравнение</a></li>
          <li><a href="#downloads" class="transition-colors hover:text-white">Все платформы</a></li>
          <li><a href="#faq" class="transition-colors hover:text-white">Вопросы</a></li>
        </ul>
      </div>

      {/* Downloads */}
      <div>
        <div class="mb-4 font-mono text-xs font-semibold text-slate-300">Сборки</div>
        <ul class="space-y-2.5 text-xs text-slate-400">
          <li><a href="#downloads" class="transition-colors hover:text-white">Windows (x64)</a></li>
          <li>
            <a href="#downloads" class="transition-colors hover:text-white">macOS Apple Silicon</a>
          </li>
          <li><a href="#downloads" class="transition-colors hover:text-white">macOS Intel</a></li>
          <li>
            <a href="#downloads" class="transition-colors hover:text-white"
              >Linux (.AppImage / .deb / .rpm)</a
            >
          </li>
        </ul>
      </div>

      {/* Legal & Status */}
      <div>
        <div class="mb-4 font-mono text-xs font-semibold text-slate-300">Лицензия и сборка</div>
        <ul class="space-y-2.5 text-xs text-slate-400">
          <li>Лицензия MIT (открытый код)</li>
          <li><FooterReleaseLabel client:load initialRelease={release} /></li>
          <li>
            <a
              href={GITHUB_REPO_URL}
              target="_blank"
              rel="noopener noreferrer"
              class="transition-colors hover:text-white">Репозиторий GitHub →</a
            >
          </li>
        </ul>
      </div>
    </div>

    {/* Bottom Bar */}
    <div
      class="flex flex-col items-center justify-between gap-4 pt-8 text-xs text-slate-500 sm:flex-row"
    >
      <p>© 2026 Obsy Launcher. Не является официальным продуктом Mojang или Microsoft.</p>
      <p class="font-mono text-[11px] text-slate-400">Open Source • Rust</p>
    </div>
  </div>
</footer>
